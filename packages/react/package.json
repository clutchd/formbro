{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@formbro/react",
  "version": "0.1.0-alpha.0",
  "description": "Early alpha React renderer and hooks for FormBro forms.",
  "keywords": [
    "form-builder",
    "forms",
    "react",
    "schema",
    "validation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clutchd/formbro",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./builder": "./src/builder.tsx",
    "./editor": "./src/editor.tsx",
    "./registry": "./src/registry.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@formbro/core": "workspace:*",
    "@formbro/shared": "workspace:*",
    "@formbro/ui": "workspace:*",
    "@remixicon/react": "catalog:",
    "@tanstack/react-form-nextjs": "1.28.3",
    "class-variance-authority": "0.7.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "slugify": "1.6.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
