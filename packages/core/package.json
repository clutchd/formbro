{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@formbro/core",
  "version": "0.1.0-alpha.0",
  "description": "Early alpha of FormBro's framework-agnostic form schema and compile pipeline.",
  "keywords": [
    "form-builder",
    "forms",
    "schema",
    "validation",
    "zod"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clutchd/formbro",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench": "bun run bench/compile.bench.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.3.0"
  }
}
